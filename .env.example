# ==============================================================================
# PRAMANA Production Environment Variables Blueprint
# ==============================================================================

# Groq Cloud API Key (Used for Llama 3.3 70B agent orchestration & Whisper v3 voice transcription)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase Credentials (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
